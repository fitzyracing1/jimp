{
  "name": "@fitzyracing1/jimp",
  "version": "1.6.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzyracing1/jimp.git",
    "directory": "packages/jimp"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "description": "An image processing library written entirely in JavaScript.",
  "files": [
    "browser.js",
    "browser.js.map",
    "dist",
    "es",
    "index.d.ts",
    "fonts",
    "types",
    "PATCH-CLOUD.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest --exclude '**/*.browser.test.ts'",
    "test:browser": "vitest --config vitest.config.browser.mjs",
    "build": "tshy",
    "build:browser": "rollup -c",
    "dev": "tshy --watch",
    "clean": "rm -rf node_modules .tshy .tshy-build dist .turbo"
  },
  "keywords": [
    "image",
    "image processing",
    "image manipulation",
    "png",
    "jpg",
    "jpeg",
    "bmp",
    "resize",
    "scale",
    "crop"
  ],
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jimp/core": "workspace:*",
    "@jimp/diff": "workspace:*",
    "@jimp/js-bmp": "workspace:*",
    "@jimp/js-gif": "workspace:*",
    "@jimp/js-jpeg": "workspace:*",
    "@jimp/js-png": "workspace:*",
    "@jimp/js-tiff": "workspace:*",
    "@jimp/plugin-blit": "workspace:*",
    "@jimp/plugin-blur": "workspace:*",
    "@jimp/plugin-circle": "workspace:*",
    "@jimp/plugin-color": "workspace:*",
    "@jimp/plugin-contain": "workspace:*",
    "@jimp/plugin-cover": "workspace:*",
    "@jimp/plugin-crop": "workspace:*",
    "@jimp/plugin-displace": "workspace:*",
    "@jimp/plugin-dither": "workspace:*",
    "@jimp/plugin-fisheye": "workspace:*",
    "@jimp/plugin-flip": "workspace:*",
    "@jimp/plugin-hash": "workspace:*",
    "@jimp/plugin-mask": "workspace:*",
    "@jimp/plugin-print": "workspace:*",
    "@jimp/plugin-quantize": "workspace:*",
    "@jimp/plugin-resize": "workspace:*",
    "@jimp/plugin-rotate": "workspace:*",
    "@jimp/plugin-threshold": "workspace:*",
    "@jimp/types": "workspace:*",
    "@jimp/utils": "workspace:*"
  },
  "devDependencies": {
    "@jimp/config-eslint": "workspace:*",
    "@jimp/config-typescript": "workspace:*",
    "@jimp/config-vitest": "workspace:*",
    "@jimp/test-utils": "workspace:*",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/browser": "^2.0.5",
    "eslint": "^9.9.1",
    "node-self": "^1.0.2",
    "path-browserify": "^1.0.1",
    "rollup": "^4.21.2",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tshy": "^3.0.2",
    "typescript": "^5.5.4",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.0.5"
  },
  "tshy": {
    "exclude": [
      "**/*.test.ts"
    ],
    "esmDialects": [
      "browser"
    ],
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts",
      "./fonts": "./src/fonts.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./fonts": {
      "browser": {
        "types": "./dist/browser/fonts.d.ts",
        "default": "./dist/browser/fonts.js"
      },
      "import": {
        "types": "./dist/esm/fonts.d.ts",
        "default": "./dist/esm/fonts.js"
      },
      "require": {
        "types": "./dist/commonjs/fonts.d.ts",
        "default": "./dist/commonjs/fonts.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "type": "module",
  "module": "./dist/esm/index.js",
  "_patchCloud": {
    "fork": "https://github.com/fitzyracing1/jimp",
    "branch": "patch-cloud",
    "upstream": "https://github.com/jimp-dev/jimp",
    "upstreamIssue": "https://github.com/jimp-dev/jimp/issues/1402",
    "baseRef": "tag v1.6.1",
    "upstreamVersion": "1.6.1",
    "fix": "Ship the real Rollup browser bundle in dist/browser/index.js (and its index.d.ts) instead of the 98-byte stub published in jimp@1.6.1, so bundlers that resolve the \"browser\" export condition get Jimp, ResizeStrategy, etc.",
    "details": "See PATCH-CLOUD.md in this package.",
    "scopedName": "@fitzyracing1/jimp",
    "unscopedName": "jimp",
    "githubPackages": "https://github.com/fitzyracing1/jimp/pkgs/npm/jimp"
  }
}
